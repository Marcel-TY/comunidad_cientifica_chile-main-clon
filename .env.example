DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=comunidad_cientifica
POSTGRES_USER=comunidad_cientifica
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional alternative for hosting providers that expose a PostgreSQL URL.
# If set, this takes precedence over the POSTGRES_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/comunidad_cientifica
